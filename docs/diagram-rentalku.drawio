        <mxCell id="p-paid-rental" value="Pesanan dibayar, lalu sewa berlangsung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="140" y="1600" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="p-complete" value="Mitra menandai pesanan selesai" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="140" y="1700" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="p-earned" value="Bagian mitra menjadi pendapatan selesai&#xa;saldo tersedia = pendapatan selesai - payout diajukan/dibayar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="110" y="1800" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="p-payout-request" value="Mitra ajukan payout dengan nominal" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="140" y="1920" width="360" height="75" as="geometry"/></mxCell>
        <mxCell id="p-payout-valid" value="Rekening lengkap, nominal minimal Rp10.000, dan saldo mencukupi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="210" y="2030" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="p-payout-error" value="Tolak permintaan&#xa;(validasi saldo / rekening / nominal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="580" y="2055" width="300" height="70" as="geometry"/></mxCell>
