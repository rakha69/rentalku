  <diagram id="flow-partner-payout" name="Flowchart Mitra dan Payout">
    <mxGraphModel dx="1600" dy="2650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2650" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p-start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="25" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p-register" value="Daftar mitra: nama, email, password, bank, rekening" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="p-wait-user" value="Akun mitra dibuat dengan status menunggu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="610" y="235" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="p-user-approval" value="Admin menyetujui akun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="p-user-reject" value="Pendaftaran ditolak&#xa;(status ditolak)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="360" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p-active" value="Akun mitra aktif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="490" width="360" height="65" as="geometry"/></mxCell>
        <mxCell id="p-vehicle-input" value="Mitra daftarkan kendaraan&#xa;foto dapat diunggah (maks. 5 MB)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="590" y="585" width="400" height="85" as="geometry"/></mxCell>
        <mxCell id="p-vehicle-review" value="Server validasi data wajib kendaraan; kendaraan baru berstatus menunggu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="590" y="710" width="400" height="75" as="geometry"/></mxCell>
        <mxCell id="p-vehicle-approval" value="Admin setujui kendaraan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="680" y="825" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="p-vehicle-reject" value="Ditolak: mitra dapat revisi lalu kirim ulang untuk verifikasi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1110" y="845" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="p-listed" value="Kendaraan berstatus tayang di katalog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="980" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="p-booking" value="Booking dibuat dan harga dihitung&#xa;komisi disimpan pada pesanan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="610" y="1085" width="360" height="75" as="geometry"/></mxCell>
        <mxCell id="p-owner" value="Pemilik kendaraan mitra?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="680" y="1195" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="p-partner-share" value="Armada mitra: platform mengambil komisi yang diatur admin (default 10%); sisa menjadi bagian mitra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="130" y="1340" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p-platform-share" value="Armada admin: 100% pendapatan menjadi bagian platform; tidak masuk saldo mitra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#C47A24;" vertex="1" parent="1"><mxGeometry x="1080" y="1340" width="390" height="90" as="geometry"/></mxCell>
