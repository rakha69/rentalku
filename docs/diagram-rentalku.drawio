        <mxCell id="p-partner-decision" value="Mitra menerima booking?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="210" y="1460" width="220" height="110" as="geometry"/></mxCell>
