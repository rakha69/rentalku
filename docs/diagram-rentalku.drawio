        <mxCell id="t-doc-error" value="Tampilkan toast validasi dokumen; kembali perbaiki input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1130" y="540" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="t-date-decision" value="Tanggal valid? Mulai hari ini atau sesudahnya, akhir setelah mulai, maks. 60 hari" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="t-date-error" value="Tampilkan pesan tanggal; perbaiki rentang sewa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1130" y="685" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="t-avail-decision" value="Kendaraan tersedia pada rentang tanggal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="810" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-unavailable" value="Pilih tanggal atau kendaraan lain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1130" y="830" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="t-create" value="Hitung harga, komisi, lalu buat booking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="965" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="t-owner" value="Kendaraan milik admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="1080" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-wait-partner" value="Status menunggu_mitra&#xa;Mitra punya batas konfirmasi 24 jam" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="120" y="1095" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="t-partner-decision" value="Mitra menerima pesanan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="185" y="1210" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-rejected" value="Ditolak / kedaluwarsa&#xa;Booking dibatalkan" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1385" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="t-admin-direct" value="Armada admin langsung&#xa;status menunggu_bayar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#C47A24;" vertex="1" parent="1"><mxGeometry x="1110" y="1100" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="t-payment" value="Mulai pembayaran&#xa;Midtrans atau mode simulasi" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="1250" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="t-payment-result" value="Hasil pembayaran?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="1370" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-pending" value="Pending: status tersimpan&#xa;Tunggu notifikasi / polling status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="280" y="1385" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="t-poll" value="Sinkronkan status dari Midtrans&#xa;(atau simulasi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4ECF8;strokeColor=#8756A3;" vertex="1" parent="1"><mxGeometry x="280" y="1510" width="280" height="75" as="geometry"/></mxCell>
        <mxCell id="t-failed" value="Gagal / ditolak / dibatalkan&#xa;Midtrans expire dipetakan sebagai gagal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1110" y="1385" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="t-expiry-decision" value="Batas waktu booking terlewati?&#xa;(status pembayaran bukan pending)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="1510" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="t-cancelled-expiry" value="expireBookings membatalkan booking" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="1810" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="t-retry" value="Pelanggan dapat mencoba bayar ulang&#xa;selama booking masih menunggu_bayar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4ECF8;strokeColor=#8756A3;" vertex="1" parent="1"><mxGeometry x="1110" y="1685" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="t-paid" value="Lunas: payment_status=lunas, status=dibayar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="1535" width="380" height="75" as="geometry"/></mxCell>
        <mxCell id="t-invoice" value="Invoice PDF tersedia setelah pembayaran lunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="620" y="1640" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="t-rental" value="Masa sewa berjalan / kendaraan digunakan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="620" y="1740" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="t-complete" value="Pemilik kendaraan tandai sewa selesai&#xa;(mitra atau admin pemilik armada)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF1E4;strokeColor=#3A8D57;" vertex="1" parent="1"><mxGeometry x="620" y="1840" width="380" height="75" as="geometry"/></mxCell>
        <mxCell id="t-end" value="Pesanan selesai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="1950" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="t-note" value="Status pending tidak dibatalkan otomatis oleh expireBookings. Untuk armada mitra, masa tunggu konfirmasi 24 jam; setelah disetujui, batas pembayaran 60 menit. Pembayaran admin langsung menunggu_bayar selama 60 menit." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A84A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="970" width="360" height="105" as="geometry"/></mxCell>

